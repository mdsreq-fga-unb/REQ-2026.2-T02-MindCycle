# Copie para .env. Os valores abaixo batem com o docker-compose.yml da raiz.
DATABASE_URL="postgresql://mindcycle:mindcycle@localhost:5432/mindcycle?schema=public"

# Gere com: openssl rand -base64 32
JWT_SECRET=""

PORT=3000

# E-mail (HU26). No desenvolvimento, o Mailpit do docker-compose.yml recebe tudo:
# veja em http://localhost:8025. Em produção as duas são obrigatórias.
SMTP_URL="smtp://localhost:1025"
EMAIL_REMETENTE="MindCycle <nao-responda@mindcycle.local>"
