// Imports com .js, como o ESM do Node exige depois de compilado. Sem isso o
// client sai com .ts e a API compilada não sobe na imagem Docker.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// HU25. Excluir a usuária apaga, em cascata, os dados de domínio dela (HU36).
model Usuaria {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  senhaHash String   @map("senha_hash")
  /// Fuso IANA do aparelho: define o "hoje" da usuária.
  fuso      String
  criadaEm  DateTime @default(now()) @map("criada_em") @db.Timestamptz

  consentimentos Consentimento[]
  inicios        InicioMenstruacao[]
  perfilCiclo    PerfilCiclo?

  @@map("usuarias")
}

// HU12, RNF02. Um registro por aceite; revogar (HU36) preenche revogadoEm.
model Consentimento {
  id           String    @id @default(uuid()) @db.Uuid
  usuariaId    String    @map("usuaria_id") @db.Uuid
  versaoTermos String    @map("versao_termos")
  aceitoEm     DateTime  @default(now()) @map("aceito_em") @db.Timestamptz
  revogadoEm   DateTime? @map("revogado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@index([usuariaId])
  @@map("consentimentos")
}

// HU06. Dia de início de uma menstruação, no calendário da usuária (sem hora).
// Registrar de novo o mesmo dia não cria outro registro.
model InicioMenstruacao {
  id        String   @id @default(uuid()) @db.Uuid
  usuariaId String   @map("usuaria_id") @db.Uuid
  data      DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@unique([usuariaId, data])
  @@map("inicios_menstruacao")
}

// HU07. Um por usuária. Ciclo irregular não guarda duração média.
model PerfilCiclo {
  usuariaId    String   @id @map("usuaria_id") @db.Uuid
  duracaoMedia Int?     @map("duracao_media")
  irregular    Boolean  @default(false)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@map("perfis_ciclo")
}

// Estado do @nestjs/authentication (RefreshTokenStore). O id é o SHA-256 do token.
// Sem chave estrangeira, como o contrato do pacote supõe: a exclusão da conta
// (HU36) revoga e apaga estes registros explicitamente.
model RefreshToken {
  id              String    @id
  familyId        String    @map("family_id")
  userId          String    @map("user_id")
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  revoked         Boolean   @default(false)
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
  @@map("refresh_tokens")
}
