// Imports com .js, como o ESM do Node exige depois de compilado. Sem isso o
// client sai com .ts e a API compilada não sobe na imagem Docker.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// HU25. Excluir a usuária apaga, em cascata, os dados de domínio dela (HU36).
model Usuaria {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  senhaHash       String    @map("senha_hash")
  /// Fuso IANA do aparelho: define o "hoje" da usuária.
  fuso            String
  criadaEm        DateTime  @default(now()) @map("criada_em") @db.Timestamptz
  /// HU11: hash do tipo e da sequência digitada; nulo quando a conta não tem PIN.
  pinHash         String?   @map("pin_hash")
  /// Como a usuária digita o PIN; nulo quando a conta não tem PIN.
  pinTipo         TipoPin?  @map("pin_tipo")
  /// Erros seguidos na verificação do PIN; zera no acerto e ao bloquear.
  pinTentativas   Int       @default(0) @map("pin_tentativas")
  /// Enquanto no futuro, toda verificação do PIN é recusada.
  pinBloqueadoAte DateTime? @map("pin_bloqueado_ate") @db.Timestamptz

  consentimentos Consentimento[]
  inicios        InicioMenstruacao[]
  perfilCiclo    PerfilCiclo?
  recuperacoes   RecuperacaoAcesso[]
  tarefas        Tarefa[]
  checkins       Checkin[]
  sobrecargas    SinalizacaoSobrecarga[]

  @@map("usuarias")
}

enum TipoPin {
  numerico
  petalas

  @@map("tipo_pin")
}

// HU12, RNF02. Um registro por aceite; revogar (HU36) preenche revogadoEm.
model Consentimento {
  id           String    @id @default(uuid()) @db.Uuid
  usuariaId    String    @map("usuaria_id") @db.Uuid
  versaoTermos String    @map("versao_termos")
  aceitoEm     DateTime  @default(now()) @map("aceito_em") @db.Timestamptz
  revogadoEm   DateTime? @map("revogado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@index([usuariaId])
  @@map("consentimentos")
}

// HU06. Dia de início de uma menstruação, no calendário da usuária (sem hora).
// Registrar de novo o mesmo dia não cria outro registro.
model InicioMenstruacao {
  id        String   @id @default(uuid()) @db.Uuid
  usuariaId String   @map("usuaria_id") @db.Uuid
  data      DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@unique([usuariaId, data])
  @@map("inicios_menstruacao")
}

// HU07. Um por usuária. Ciclo irregular não guarda duração média.
model PerfilCiclo {
  usuariaId    String   @id @map("usuaria_id") @db.Uuid
  duracaoMedia Int?     @map("duracao_media")
  irregular    Boolean  @default(false)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@map("perfis_ciclo")
}

// HU26. Código de 6 dígitos enviado por e-mail para redefinir a senha; só o hash
// fica guardado. Vale enquanto não vence, não foi usado e as tentativas não esgotam.
model RecuperacaoAcesso {
  id         String    @id @default(uuid()) @db.Uuid
  usuariaId  String    @map("usuaria_id") @db.Uuid
  codigoHash String    @map("codigo_hash")
  criadoEm   DateTime  @map("criado_em") @db.Timestamptz
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz
  /// Confirmações feitas com este código vigente, certas ou erradas.
  tentativas Int       @default(0)
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@index([usuariaId])
  @@map("recuperacoes_acesso")
}

// Estado do @nestjs/authentication (RefreshTokenStore). O id é o SHA-256 do token.
// Sem chave estrangeira, como o contrato do pacote supõe: a exclusão da conta
// (HU36) revoga e apaga estes registros explicitamente.
model RefreshToken {
  id              String    @id
  familyId        String    @map("family_id")
  userId          String    @map("user_id")
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  revoked         Boolean   @default(false)
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
  @@map("refresh_tokens")
}

// HU17. A data planejada nasce no dia do cadastro e só muda pelo adiamento (HU18)
// ou pelo reajuste (HU15); o prazo final não muda com ela.
model Tarefa {
  id             String    @id @default(uuid()) @db.Uuid
  usuariaId      String    @map("usuaria_id") @db.Uuid
  titulo         String
  prazo          DateTime  @db.Date
  /// 1 baixa, 2 média, 3 alta.
  prioridade     Int
  /// Energia necessária: 1 baixa, 2 média, 3 alta.
  energia        Int
  duracaoMinutos Int?      @map("duracao_minutos")
  dataPlanejada  DateTime  @map("data_planejada") @db.Date
  criadaEm       DateTime  @default(now()) @map("criada_em") @db.Timestamptz
  /// Preenchida pela conclusão (HU20).
  concluidaEm    DateTime? @map("concluida_em") @db.Timestamptz

  movimentacoes MovimentacaoTarefa[]

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@index([usuariaId, dataPlanejada])
  @@map("tarefas")
}

enum OrigemCheckin {
  registro
  sobrecarga

  @@map("origem_checkin")
}

// HU04. Vários por dia; o vigente do dia é o mais recente por criadoEm e os
// anteriores ficam no histórico. A correção troca o conteúdo sem mudar criadoEm.
model Checkin {
  id           String        @id @default(uuid()) @db.Uuid
  usuariaId    String        @map("usuaria_id") @db.Uuid
  /// O dia no calendário da usuária, calculado pelo Relogio na criação.
  dataLocal    DateTime      @map("data_local") @db.Date
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz
  /// Níveis de HU13: 1 baixa, 2 média, 3 alta.
  disposicao   Int
  /// Indicação explícita de ausência de sintomas: nunca junto com sintomas.
  semSintomas  Boolean       @map("sem_sintomas")
  /// Só nasce `registro`: a sinalização de sobrecarga (HU02) ficou numa tabela
  /// própria, `sinalizacoes_sobrecarga`, e o valor `sobrecarga` não é usado.
  origem       OrigemCheckin @default(registro)

  usuaria  Usuaria          @relation(fields: [usuariaId], references: [id], onDelete: Cascade)
  sintomas CheckinSintoma[]

  @@index([usuariaId, dataLocal, criadoEm])
  @@map("checkins")
}

// HU04. Só os sintomas selecionados existem aqui, cada um com a intensidade.
model CheckinSintoma {
  id          String @id @default(uuid()) @db.Uuid
  checkinId   String @map("checkin_id") @db.Uuid
  /// Id estável da lista SINTOMAS de @mindcycle/shared.
  sintoma     String
  /// 1 leve, 2 moderada, 3 intensa.
  intensidade Int

  checkin Checkin @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  @@unique([checkinId, sintoma])
  @@map("checkin_sintomas")
}

// HU02. Uma linha por sinalização de sobrecarga, várias por dia. A mais recente
// do dia vale como disposição baixa enquanto não houver check-in depois dela
// (HU15); sem sintomas, ela não cabe nas regras de `Checkin`.
model SinalizacaoSobrecarga {
  id        String   @id @default(uuid()) @db.Uuid
  usuariaId String   @map("usuaria_id") @db.Uuid
  /// O dia no calendário da usuária, calculado pelo Relogio na criação.
  dataLocal DateTime @map("data_local") @db.Date
  /// Como o de `Checkin`, o Prisma preenche com o relógio do processo da API: os
  /// dois instantes se comparam, numa instância só (ver disposicao-do-dia.ts).
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuaria Usuaria @relation(fields: [usuariaId], references: [id], onDelete: Cascade)

  @@index([usuariaId, dataLocal, criadoEm])
  @@map("sinalizacoes_sobrecarga")
}

// HU18/HU15: permite distinguir escolha da usuária de reajuste automático.
enum OrigemMovimentacaoTarefa {
  usuaria
  reajuste

  @@map("origem_movimentacao_tarefa")
}

model MovimentacaoTarefa {
  id           String                   @id @default(uuid()) @db.Uuid
  tarefaId     String                   @map("tarefa_id") @db.Uuid
  dataAnterior DateTime                 @map("data_anterior") @db.Date
  dataNova     DateTime                 @map("data_nova") @db.Date
  origem       OrigemMovimentacaoTarefa
  criadaEm     DateTime                 @map("criada_em") @db.Timestamptz

  // A cascata da conta alcança o histórico pela tarefa (HU36).
  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId, criadaEm])
  @@map("movimentacoes_tarefa")
}
